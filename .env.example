# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# YouTube Data API Key
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Bot Configuration
BOT_PREFIX=/
BOT_LANGUAGE=de

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=False
